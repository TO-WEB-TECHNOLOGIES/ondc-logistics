NODE_ENV=development

PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ondc_logistics

REDIS_URL=redis://localhost:6379

# APP & ENVIRONMENT
ENV=PREPROD
BFF=http://localhost:3000

# PLATFORM & ONDC CREDENTIALS
SUBSCRIBER_ID=your-app-domain.com
UNIQUE_KEY_ID=1

# ONDC KEYS (Ed25519 for Signing, X25519 for Encryption)
SIGNING_PRIVATE_KEY=your_base64_or_hex_signing_private_key
SIGNING_PUBLIC_KEY=your_base64_or_hex_signing_public_key
ENCRYPTION_PRIVATE_KEY=your_base64_or_hex_encryption_private_key
ENCRYPTION_PUBLIC_KEY=your_base64_or_hex_encryption_public_key

# ONDC REGISTRY & GATEWAY URLS (Optional - defaults provided in code)
PREPROD_REGISTRY_URL=
PROD_REGISTRY_URL=
PREPROD_GATEWAY_URL=
PROD_GATEWAY_URL=